# Questions the installer must answer for this service — NOT settings.
#
# Values are intentionally empty. The node's installer (`npm run services:install`)
# reads this file, and the `# kind:` line above each variable tells it WHO answers:
#
#   derived — the installer knows the answer itself (assigned port, node address, languages)
#   secret  — the installer generates a random value and writes it to BOTH ends
#   foreign — a third-party key: the installer asks the human and says what breaks without it
#
# The generated file is `.env.local` in this folder. Never edit that file by hand:
# it is rewritten on every install and your change disappears silently.
#
# 🪦 Before the move into this repository (2026-09-20) this file carried concrete
# values from the server line — the domain `partner.fractera.local` and ports
# 3000/3001/3002/3300. They are gone on purpose: in the AGI line the node lives on
# a home computer, the port comes from the block 24680-24699 and is assigned by the
# node, and a remembered address is wrong the day it is given away.

# Cookie domain shared by the node and this service. Empty = host-only cookie,
# which is what a single machine needs.
# kind: derived
COOKIE_DOMAIN=

# `true` only behind HTTPS. On a home machine the node is reached over http://localhost,
# where a Secure cookie is never sent back.
# kind: derived
COOKIE_SECURE=

# Public address of THIS service, exactly as the browser sees it. NextAuth compares
# it byte for byte and answers "Bad request." on any mismatch.
# kind: derived
NEXTAUTH_URL=

# Session signing key. 32 random bytes, base64.
# kind: secret
NEXTAUTH_SECRET=

# SQLite file of this service. Relative paths resolve against this folder.
# kind: derived
DATABASE_URL=

# Token that lets the node's architect layer ask this service for a session
# without a browser. Shared by both ends.
# kind: secret
ARCHITECT_TOKEN=

# Comma-separated origins allowed to call this service. The node's address goes here.
# kind: derived
ALLOWED_ORIGINS=

# Node design (280-10). Absolute path to this service's DESIGN-CONFIG/design-config.json: the standalone
# server runs from its build folder, so a relative path would write settings INSIDE the build.
# kind: derived
DESIGN_CONFIG_PATH=

# The key of the settings door (/api/settings/design): the node core presents it. Generated once by
# the installer and written to both ends.
# kind: secret
SETTINGS_SECRET=

# Standard header and footer of the project (node step 283): the site's menu door, the header adds /<lang>.
# kind: derived
PROJECT_MENU_URL=

# Where the header and footer links lead: the site's public address, otherwise its loopback.
# kind: derived
PROJECT_SITE_URL=
